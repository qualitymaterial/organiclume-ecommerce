            ],
            "id": "gmail-fetch",
            "name": "Get Unread Emails",
            "credentials": {
                "gmailOAuth2": {
                    "id": "NS1cAa8FAa6ydxcs",
                    "name": "Gmail account"
                }
            },
            "webhookId": "011b8937-b67b-445b-91ab-5f2fdb2637e9"
        },
        {
            "parameters": {
                "jsCode": "const from = $input.first().json.from || '';\nconst subject = $input.first().json.subject || '';\nconst body = ($input.first().json.text || $input.first().json.snippet || '(no body)').substring(0, 2000);\n\nconst systemPrompt = `You are Celeste, the Customer Success Lead for Organic Lume. Your voice is professional, minimalist, and luxury-focused.\n\nBrand Context:\n- Product: 22 momme 6A Mulberry Silk Heatless Hair Curler Sets\n- Core Values: Sustainable luxury, effortless beauty\n- Target COGS: $2-$3.50 per unit, OEKO-TEX certified\n\nInstructions:\n1. If from a VENDOR/manufacturer: Inquire about bulk pricing, MOQ, samples, lead times, OEKO-TEX.\n2. If from a CUSTOMER: Be warm and helpful about the product. Sign off with \"Warm regards, Celeste | Organic Lume\"\n3. If spam/system notification: Reply with just SKIP\n4. Keep responses concise. Respond with ONLY the email reply text.`;\n\nconst userMsg = `From: ${from}\\nSubject: ${subject}\\nBody:\\n${body}`;\n\nconst apiKey = $env.ANTHROPIC_API_KEY;\n\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://api.anthropic.com/v1/messages',\n  headers: {\n    'Content-Type': 'application/json',\n    'x-api-key': apiKey,\n    'anthropic-version': '2023-06-01'\n  },\n  body: {\n    model: 'claude-haiku-4-5-20251001',\n    max_tokens: 1024,\n    system: systemPrompt,\n    messages: [{ role: 'user', content: userMsg }]\n  },\n  json: true\n});\n\nconst reply = response.content?.[0]?.text || 'Error: ' + JSON.stringify(response);\n\nif (reply.trim() === 'SKIP') {\n  return [{ json: { skip: true, reason: \"System/spam email\" } }];\n}\n\nreturn [{ json: { reply, from, subject } }];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                220,
                48
            ],
            "id": "celeste-code",
            "name": "Celeste AI"
        },
        {
            "parameters": {
                "resource": "draft",
                "subject": "=Re: {{ $json.subject }}",
                "message": "={{ $json.reply }}",
                "options": {}
            },
