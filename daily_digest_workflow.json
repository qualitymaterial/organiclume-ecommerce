        {
            "parameters": {
                "jsCode": "const now = new Date();\nconst dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });\n\n// Get Gmail unread count\nlet unreadCount = 0;\nlet unreadSubjects = [];\ntry {\n  const gmailData = $node[\"Get Inbox Summary\"].json;\n  if (Array.isArray($node[\"Get Inbox Summary\"].json)) {\n    unreadCount = $node[\"Get Inbox Summary\"].json.length || 0;\n  } else {\n    unreadCount = 1;\n  }\n} catch(e) {\n  unreadCount = 0;\n}\n\n// Build digest\nconst digest = `\n# \u2600\ufe0f Organic Lume Daily Digest\n**${dateStr}**\n\n---\n\n## \ud83d\udcec Inbox\n- **${unreadCount}** unread emails in hello@organiclume.com\n\n## \ud83d\udccb Quick Actions\n- Review any vendor RFQ responses\n- Check Paperclip board for agent updates: http://localhost:3101/LUM/dashboard\n- Review and send any Gmail drafts from Celeste\n\n## \ud83c\udfaf Active Priorities\n1. Vendor RFQ responses (FSTex, Stitchtex, Taihu Snow) \u2014 check inbox\n2. Shopify theme selection and customization\n3. Social accounts setup (Pinterest, TikTok, Instagram)\n4. Product line expansion sourcing\n\n---\n*Automated by Celeste | Organic Lume*\n`;\n\nreturn [{ json: { digest, subject: `\u2600\ufe0f Organic Lume Digest \u2014 ${dateStr}` } }];"
            },
